# ==============================================================================
# BUMAND — Archivo .gitignore Maestro
# ==============================================================================

# Dependencias de paquetes
node_modules/
.pnp
.pnp.js

# Testing y Cobertura
coverage/
*.lcov
test_cache/
unit_test_assets/

# Producción, Compilación y Empaquetado
build/
dist/
.next/
out/
.turbo/
*.tsbuildinfo
.eslintcache

# Archivos de Entorno y Claves Privadas
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key

# Logs del Sistema y Gestores de Paquetes
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Documentación LaTeX y Auxiliares
*.tex
*.aux
*.log
*.out
*.toc
*.lof
*.lot
*.fls
*.fdb_latexmk
*.synctex.gz

# Documentación en PDF generada (se ignoran todos excepto el original del repositorio)
*.pdf
!DOCUMENTACION_GENERAL_BUMAND.pdf

# Documentación Markdown generada / auxiliar (solo se preservan los originales)
/*.md
!/README.md
!/USUARIOS_PRUEBA.md
documentacion/

# Archivos Temporales y Documentos de Casos de Uso No Esenciales
/_prototipos/
/documentacion-casos-de-uso-bummans/
*.docx
*.xlsx
*.txt
~$*
*.tmp
*.bak
*~

# Entornos de Desarrollo e IDEs
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo

# Dart y Flutter Herramientas Temporales
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
*.dill

# Sistema Operativo (Windows / macOS / Linux)
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Reglas Internas de Agentes y Memoria de Diseño
.agents/
.antigravity-design/
AudiosyDocumentosBumands/